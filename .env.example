# Dev-only credentials. Copy to .env for local development:  cp .env.example .env
# NEVER reuse these values in any deployed environment.

# --- Postgres superuser (compose bootstraps this role; owns the database) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=togglr

# --- Request-path role (created by the baseline migration; non-superuser, RLS applies) ---
TOGGLR_APP_PASSWORD=togglr_app_dev_pw

# Migrations run as the privileged superuser (creates roles, owns tables, creates RLS policies).
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/togglr
# The API request path connects as the non-privileged togglr_app role (RLS enforced).
DATABASE_URL=postgres://togglr_app:togglr_app_dev_pw@localhost:5432/togglr

REDIS_URL=redis://localhost:6379

# NestJS API port (also used by the web dev proxy).
PORT=3000

# --- Kysely/pg connection pool (optional; shown values are the defaults) ---
# DB_POOL_MAX=10                     # max clients in the request-path pool
# DB_POOL_CONNECTION_TIMEOUT_MS=5000 # fail pool acquisition if no client in this window
# DB_POOL_IDLE_TIMEOUT_MS=10000      # close idle clients after this long (0 = never)

# --- Sessions & cookies (optional; shown values are the defaults) ---
# SESSION_IDLE_TTL_S=1800            # sliding idle timeout (30 min)
# SESSION_ABSOLUTE_TTL_S=43200       # hard session cap regardless of activity (12 h)
# COOKIE_SECURE=true                 # Secure flag on the session cookie.
# Set COOKIE_SECURE=false for local dev: the SPA is served over http://localhost
# via the Vite proxy, and a Secure cookie won't round-trip over plain http.
